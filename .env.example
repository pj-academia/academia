# Postgres (container) and the URL the backend uses to reach it.
POSTGRES_USER=academia
POSTGRES_PASSWORD=academia
POSTGRES_DB=academia
DATABASE_URL=postgresql+asyncpg://academia:academia@localhost:5432/academia

# ChromaDB is published on 8001 so it does not clash with the backend on 8010.
CHROMA_URL=http://localhost:8001

# Backend
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Frontend: inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8010

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
